// Instructors v1 — EXTENDS AppUser, never replaces it.
//
// An instructor already IS an `AppUser` with role = INSTRUCTOR, and four live
// surfaces depend on that today:
//   • Course.instructorId       → FK to app_users   (learning.prisma)
//   • LiveSession.instructorId  → FK to app_users   (learning.prisma)
//   • "Active Instructors" KPI  → counts app_users  (dashboard.service)
//   • LM instructor dropdown    → reads app_users   (lm.service filter-options)
// A parallel `instructors` table would fork all four (IMPACT_MAP B2 — same
// reasoning as Certificate / CourseContent / LiveSession, which were all
// EXTENDED in place rather than duplicated).
//
// So this file adds ONE optional side table holding only instructor-specific
// fields. Identity, status and verificationState stay owned by AppUser and are
// written exclusively through users.service — instructors.service delegates.
//
// The profile row is OPTIONAL on purpose: every INSTRUCTOR that existed before
// this feature (and every one created through POST /api/admin/users) has no
// profile, and MUST still appear in the Instructors table. Reads left-join it.
model InstructorProfile {
  id     String @id @default(uuid())
  userId String @unique

  specialization  String?
  headline        String?
  bio             String?
  yearsExperience Int?
  websiteUrl      String?
  linkedinUrl     String?

  // Revenue share in BASIS POINTS (1250 = 12.50%) — integer, same reasoning as
  // Course.price being cents: no floating-point money. Stored now, consumed
  // when the Finance module exists. Nothing reads it in v1.
  revenueShareBps Int?

  // Stamped by PATCH /instructors/:id/verify alongside the AppUser
  // verificationState flip (which remains the single source of truth for
  // "is this instructor verified" — this is provenance, not state).
  verifiedAt   DateTime?
  verifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([specialization])
  @@map("instructor_profiles")
}

// Public "Become Instructor" queue (blueprint 05 §3). Submissions arrive on the
// unauthenticated POST /api/public/instructor-applications; admins review them
// under /api/admin/instructor-applications.
//
// `email` is deliberately NOT unique: a rejected applicant may reapply, and an
// approved one keeps their historical row. "One OPEN application per email" is
// enforced in the service (same app-side pattern as invitations.service).
//
// `createdUserId` is set when an application is approved and is UNIQUE, so a
// concurrent double-approve loses at the database level (P2002 → 409) and can
// never mint two accounts from one application.
model InstructorApplication {
  id              String   @id @default(uuid())
  fullName        String
  email           String
  phone           String?
  headline        String?
  bio             String?
  specialization  String?
  skills          String[] @default([])
  yearsExperience Int?

  // v1 accepts LINKS ONLY (validated http/https). File upload would require an
  // unauthenticated storage surface; the admin uploads flow stays admin-only.
  cvUrl        String?
  portfolioUrl String?

  status          InstructorApplicationStatus @default(PENDING)
  reviewNotes     String?
  rejectionReason String?
  changeRequest   String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdUserId   String?                     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("instructor_applications")
}

enum InstructorApplicationStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

// Administrative documents held on file for an instructor (blueprint 05 §12).
//
// SCOPE: administrative paperwork ONLY. Teaching certificates, licences and
// degrees are a DIFFERENT entity with their own verification queue and their own
// tab (blueprint 05 §11) — there is deliberately no CERTIFICATION type here, so
// the two never become two half-implementations of each other.
//
// The row stores the storage KEY (`filePath`), never a public URL: the bucket is
// private and every read mints a short-lived signed URL. Identity and tax
// documents are the most sensitive data this system holds, and a stored public
// URL is a permanent, unrevocable grant to anyone who ever sees it.
model InstructorDocument {
  id           String @id @default(uuid())
  instructorId String

  type   InstructorDocumentType
  status InstructorDocumentStatus @default(PENDING)

  fileName String
  // Key inside the private bucket: instructors/<instructorId>/<uuid>-<name>.
  // Required — without it the object can be neither signed for download nor
  // deleted, which is how orphaned files accumulate in a bucket forever.
  filePath String
  fileSize Int
  mimeType String

  // Set by /reject. Cleared again by /verify, so a re-verified document does not
  // keep contradicting itself.
  rejectionReason String?

  // Expiry is a property of the DOCUMENT, not of the row: contracts, agreements
  // and tax forms lapse on a date the file itself states. Null = does not expire.
  expiresAt DateTime?

  uploadedById String?
  uploadedAt   DateTime  @default(now())
  verifiedAt   DateTime?
  verifiedById String?

  updatedAt DateTime @updatedAt

  instructor AppUser @relation("InstructorDocuments", fields: [instructorId], references: [id], onDelete: Cascade)

  // Every list read is scoped to one instructor and usually one status/type.
  @@index([instructorId, status])
  @@index([instructorId, type])
  @@map("instructor_documents")
}

enum InstructorDocumentType {
  IDENTITY
  CONTRACT
  AGREEMENT
  TAX
  COMPLIANCE
}

enum InstructorDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  // Soft delete. Blueprint 05 §12 lists Archive, not Delete, and every other
  // module here soft-deletes — a compliance record that an admin can erase
  // outright is not a compliance record.
  ARCHIVED
}

// Student reviews of an instructor's courses (blueprint 05 §10-ish / moderation
// queue). NOTE: INSTRUCTORS_CONTRACT.md v1 documents "no Review model" and lists
// this as a [planned] gap ("decision for Hassan, not a bug") — shipped anyway on
// 2026-08-07 at the user's explicit direction (see INSTRUCTORS_CONTRACT.md
// changelog). Flagged here so the contract mismatch is traceable, not hidden.
//
// A review is left by a STUDENT (AppUser, role LEARNER) on a COURSE taught by
// the instructor — three-way link, not a duplicate of CourseEnrollment.
model InstructorReview {
  id           String @id @default(uuid())
  instructorId String
  studentId    String
  courseId     String

  rating  Int // 1-5. No write endpoint creates these rows in this system (no
  // student-facing app exists — see the addendum in INSTRUCTORS_CONTRACT.md);
  // this is a moderation queue over rows seeded/inserted directly.
  comment String?

  status InstructorReviewStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instructor AppUser @relation("InstructorReviews", fields: [instructorId], references: [id], onDelete: Cascade)
  student    AppUser @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  course     Course  @relation("CourseReviews", fields: [courseId], references: [id], onDelete: Cascade)

  // Every list read is scoped to one instructor and usually one status.
  @@index([instructorId, status])
  @@index([courseId])
  @@index([studentId])
  @@map("instructor_reviews")
}

enum InstructorReviewStatus {
  PENDING
  APPROVED
  REMOVED
  FLAGGED
}

// Teaching certificates / licences / degrees (blueprint 05 §11) — a SEPARATE
// entity from InstructorDocument (administrative paperwork, above): different
// verification queue, different data shape. INSTRUCTORS_CONTRACT.md v1
// deliberately did NOT ship this ("folding them into Documents would have made
// both half-features") — shipped anyway on 2026-08-07 at the user's explicit
// direction. Same private-bucket sign/confirm upload flow as InstructorDocument,
// own bucket/prefix (see instructorCertifications.service).
model InstructorCertification {
  id           String @id @default(uuid())
  instructorId String

  name   String
  type   InstructorCertificationType
  issuer String

  // Key inside the private bucket (instructorCertifications.service), never a
  // public URL — same reasoning as InstructorDocument.filePath. Null until the
  // sign→PUT→confirm flow completes.
  fileUrl String?

  status InstructorCertificationStatus @default(PENDING)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  verifiedAt   DateTime?
  verifiedById String?

  instructor AppUser @relation("InstructorCertifications", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, status])
  @@map("instructor_certifications")
}

enum InstructorCertificationType {
  TEACHING
  PROFESSIONAL
  ACADEMIC
  TECHNICAL
  TRAINING
}

enum InstructorCertificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

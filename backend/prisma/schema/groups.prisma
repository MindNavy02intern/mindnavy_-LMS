model Group {
  id           String             @id @default(cuid())
  name         String             @unique
  description  String?
  departmentId String?
  leaderId     String?
  status       String             @default("ACTIVE")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      GroupMember[]
  department   Department?        @relation(fields: [departmentId], references: [id])
  leader       AppUser?           @relation("GroupLeader", fields: [leaderId], references: [id])
  // Cohort-scoped enrollments (learning.prisma CourseEnrollment.cohortId) —
  // Learners module Part 3. Optional: most enrollments have no cohort.
  enrollments  CourseEnrollment[]

  @@index([departmentId])
  @@index([leaderId])
  @@index([status])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String?
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     AppUser  @relation("GroupMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

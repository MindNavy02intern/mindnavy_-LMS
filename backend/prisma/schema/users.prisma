model AppUser {
  id                String                   @id @default(uuid())
  email             String                   @unique
  passwordHash      String?
  fullName          String
  avatar            String?
  role              AppUserRole
  status            AppUserStatus            @default(PENDING)
  verificationState AppUserVerificationState @default(PENDING)
  lastActivityAt    DateTime?
  riskScore         Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  accessLevel       String?
  branch            String?
  department        String?
  emailVerified     Boolean                  @default(false)
  groupId           String?
  managerId         String?
  phone             String?
  phoneVerified     Boolean                  @default(false)
  skills            String[]

  // Organization FK columns — separate from legacy `branch` / `department` string labels
  branchId          String?
  departmentId      String?
  teamId            String?

  orgBranch         Branch?      @relation("AppUserBranch",      fields: [branchId],     references: [id])
  orgDepartment     Department?  @relation("AppUserDepartment",  fields: [departmentId], references: [id])
  orgTeam           Team?        @relation("AppUserTeam",        fields: [teamId],       references: [id])

  managedBranches    Branch[]     @relation("BranchManager")
  managedDepartments Department[] @relation("DeptManager")
  managedTeams       Team[]       @relation("TeamLeader")
  groups             GroupMember[] @relation("GroupMembers")
  leadingGroups      Group[]      @relation("GroupLeader")

  @@index([branchId])
  @@index([departmentId])
  @@index([teamId])
  @@index([role])
  @@index([status])
  @@index([verificationState])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@map("app_users")
}

enum AppUserRole {
  LEARNER
  INSTRUCTOR
  MANAGER
  ADMIN_ASSISTANT
}

enum AppUserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
  INVITED
}

enum AppUserVerificationState {
  VERIFIED
  PENDING
  REJECTED
  EXPIRED
}

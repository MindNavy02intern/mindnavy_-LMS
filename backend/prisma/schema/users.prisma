model AppUser {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  passwordHash       String?
  fullName           String
  avatar             String?
  role               AppUserRole
  status             AppUserStatus            @default(PENDING)
  verificationState  AppUserVerificationState @default(PENDING)
  lastActivityAt     DateTime?
  riskScore          Int?
  suspendedAt        DateTime?                @map("suspended_at")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  accessLevel        String?
  branch             String?
  department         String?
  emailVerified      Boolean                  @default(false)
  groupId            String?
  managerId          String?
  phone              String?
  phoneVerified      Boolean                  @default(false)
  skills             String[]
  branchId           String?
  departmentId       String?
  teamId             String?
  receivedMessages   AdminMessage[]           @relation("UserReceivedMessages")
  sessions           AppUserSession[]
  orgBranch          Branch?                  @relation("AppUserBranch", fields: [branchId], references: [id])
  orgDepartment      Department?              @relation("AppUserDepartment", fields: [departmentId], references: [id])
  orgTeam            Team?                    @relation("AppUserTeam", fields: [teamId], references: [id])
  managedBranches    Branch[]                 @relation("BranchManager")
  certificates       Certificate[]
  courseEnrollments  CourseEnrollment[]
  coursesInstructed  Course[]                 @relation("CourseInstructor")
  liveSessionsHosted LiveSession[]            @relation("LiveSessionInstructor")
  managedDepartments Department[]             @relation("DeptManager")
  groups             GroupMember[]            @relation("GroupMembers")
  leadingGroups      Group[]                  @relation("GroupLeader")
  managedTeams       Team[]                   @relation("TeamLeader")
  roleAssignments    UserRoleAssignment[]
  // Optional instructor-specific fields (instructors.prisma). Null for every
  // non-instructor AND for instructors created before the Instructors module —
  // reads must left-join it, never filter on its existence.
  instructorProfile  InstructorProfile?

  @@index([branchId])
  @@index([departmentId])
  @@index([teamId])
  @@index([role])
  @@index([status])
  @@index([verificationState])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@map("app_users")
}

model AppUserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("app_user_sessions")
}

model Invitation {
  id              String   @id @default(cuid())
  email           String
  role            String
  department      String?
  status          String   @default("PENDING")
  expiresAt       DateTime
  invitedBy       String
  personalMessage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedBy])
  @@map("invitations")
}

enum AppUserRole {
  LEARNER
  INSTRUCTOR
  MANAGER
  ADMIN_ASSISTANT
}

enum AppUserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
  INVITED
}

enum AppUserVerificationState {
  VERIFIED
  PENDING
  REJECTED
  EXPIRED
}

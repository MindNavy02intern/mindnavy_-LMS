model AccessPolicy {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  resource    PolicyResource
  action      PolicyAction
  effect      PolicyEffect   @default(ALLOW)
  priority    Int            @default(0)
  status      RoleStatus     @default(ACTIVE)
  roleId      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  role        Role?          @relation(fields: [roleId], references: [id])

  @@index([status])
  @@index([resource])
  @@index([roleId])
  @@map("access_policies")
}

enum PolicyResource {
  USERS
  REPORTS
  SETTINGS
  ORGANIZATION
  LEARNERS
  COURSES
  ADMIN
}

enum PolicyAction {
  VIEW
  CREATE
  EDIT
  DELETE
  MANAGE
  EXPORT
}

enum PolicyEffect {
  ALLOW
  DENY
}

  USER_ROLE_ASSIGNED
  USER_DELETED
  USER_ANALYTICS_VIEWED
  USER_SUSPENDED
  USER_REACTIVATED
  USERS_IMPORTED
  USERS_EXPORTED
  USER_VERIFICATION_APPROVED
  USER_MESSAGE_SENT
  USER_FORCE_LOGOUT
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_PERMISSIONS_UPDATED
  ROLE_DUPLICATED
  ACCESS_POLICY_CREATED
  ACCESS_POLICY_UPDATED
  ACCESS_POLICY_DELETED
  ROLE_TEMPLATE_CREATED
  ROLE_TEMPLATE_APPLIED
  ROLE_TEMPLATE_DELETED
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_ARCHIVED
  USER_PERMANENTLY_DELETED

// Roles & Permissions "Company Roles" tab — roles for ADMIN CONSOLE
// operators (AdminUser), distinct from the existing Role model (LMS-side
// roles assigned to AppUser via UserRoleAssignment, e.g. Learner/Instructor).
// AdminUser.role stays a plain string (unchanged) and is matched against
// CompanyRole.name loosely (same "no FK" convention as changedById
// elsewhere) — nothing here enforces permissions yet, this is the console
// role catalog + CRUD; wiring it into requireAdminAuth is a separate,
// security-sensitive change not in scope for this pass.
model CompanyRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false) // seeded/built-in — blocked from delete
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_roles")
}

// Roles & Permissions "Delegated Admins" tab — a time-boxed grant record
// (who granted elevated console access to whom, under which company role,
// until when). CRUD + audit trail only, same scope note as CompanyRole
// above: no auth-middleware enforcement wired to this yet.
model DelegatedAdmin {
  id          String    @id @default(cuid())
  adminId     String
  grantedById String
  scopeRole   String
  reason      String?
  status      String    @default("ACTIVE") // ACTIVE | REVOKED
  expiresAt   DateTime?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?

  @@index([adminId])
  @@index([status])
  @@map("delegated_admins")
}

// Admin notes on an AppUser (Users "More" tab, Notes tile). Mirrors
// AdminMessage's sender/receiver shape (messages.prisma) — one admin author,
// one AppUser subject — rather than inventing a new relation pattern.
model UserNote {
  id          String    @id @default(uuid())
  userId      String
  content     String
  createdById String
  createdAt   DateTime  @default(now())
  user        AppUser   @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   AdminUser @relation("AdminCreatedUserNotes", fields: [createdById], references: [id])

  @@index([userId])
  @@map("user_notes")
}

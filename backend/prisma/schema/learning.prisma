model Course {
  id           String             @id @default(uuid())
  title        String
  category     String
  level        CourseLevel        @default(BEGINNER)
  status       CourseStatus       @default(DRAFT)
  thumbnail    String?
  instructorId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String?
  description  String?
  language     String?
  subtitle     String?
  tags         String[]           @default([])
  certificates Certificate[]
  contents     CourseContent[]
  enrollments  CourseEnrollment[]
  sections     CourseSection[]
  instructor   AppUser?           @relation("CourseInstructor", fields: [instructorId], references: [id])
  liveSessions LiveSession[]

  @@index([status])
  @@index([category])
  @@index([level])
  @@index([instructorId])
  @@index([createdAt])
  @@map("courses")
}

model CourseEnrollment {
  id          String           @id @default(uuid())
  courseId    String
  userId      String
  progress    Int              @default(0)
  status      EnrollmentStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([status])
  @@index([completedAt])
  @@index([createdAt])
  @@map("course_enrollments")
}

model CourseContent {
  id        String      @id @default(uuid())
  courseId  String
  title     String
  type      ContentType
  createdAt DateTime    @default(now())
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([type])
  @@index([createdAt])
  @@map("course_contents")
}

model LiveSession {
  id        String            @id @default(uuid())
  title     String
  courseId  String?
  startTime DateTime
  status    LiveSessionStatus @default(UPCOMING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  course    Course?           @relation(fields: [courseId], references: [id])

  @@index([status])
  @@index([startTime])
  @@index([courseId])
  @@map("live_sessions")
}

model Certificate {
  id       String   @id @default(uuid())
  courseId String
  userId   String
  issuedAt DateTime @default(now())
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([issuedAt])
  @@map("certificates")
}

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
  @@index([order])
  @@map("course_sections")
}

model Lesson {
  id          String        @id @default(uuid())
  sectionId   String
  title       String
  type        LessonType    @default(TEXT)
  content     String?
  durationMin Int?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([order])
  @@map("lessons")
}

enum LessonType {
  TEXT
  VIDEO_URL
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  PUBLISHED
  DRAFT
  PENDING
  ARCHIVED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ContentType {
  VIDEO
  DOCUMENT
  PDF
  QUIZ
  SCORM
}

enum LiveSessionStatus {
  UPCOMING
  LIVE
  ENDED
}

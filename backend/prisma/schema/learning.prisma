model Course {
  id           String       @id @default(uuid())
  title        String
  category     String
  level        CourseLevel  @default(BEGINNER)
  status       CourseStatus @default(DRAFT)
  thumbnail    String?
  instructorId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String?
  description  String?
  language     String?
  subtitle     String?
  tags         String[]     @default([])

  // Wizard Step 4 — settings. Owned exclusively by PATCH /courses/:id/settings;
  // the generic course PATCH never reads or writes these. price is integer cents.
  isFree             Boolean          @default(true)
  price              Int?
  currency           String?          @default("USD")
  enrollmentLimit    Int?
  visibility         CourseVisibility @default(PUBLIC)
  certificateEnabled Boolean          @default(false)
  dripContentEnabled Boolean          @default(false)
  accessRules        Json?
  seoTitle           String?
  seoDescription     String?

  // Approval workflow (submit → approve/reject). reviewedById = deciding admin;
  // rejectionReason is cleared again on resubmit/approve.
  // submittedAt is stamped on every DRAFT→PENDING transition (including a
  // resubmit after rejection) and is the ONLY truthful "waiting since" source —
  // updatedAt is overwritten by any later edit. Null on courses submitted before
  // this column existed; readers must tolerate that.
  rejectionReason String?
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?

  // Categories migration: optional FK alongside the legacy free-text `category`
  // string. Both are written in parallel until the frontend fully migrates.
  categoryId String?

  certificates Certificate[]
  contents     CourseContent[]
  enrollments  CourseEnrollment[]
  sections     CourseSection[]
  instructor   AppUser?           @relation("CourseInstructor", fields: [instructorId], references: [id])
  categoryRef  Category?          @relation(fields: [categoryId], references: [id])
  liveSessions LiveSession[]
  quizzes      Quiz[]
  // Student reviews of the instructor for THIS course (instructors.prisma).
  reviews      InstructorReview[] @relation("CourseReviews")
  // Content Library reuse — a content item borrowed into THIS course, distinct
  // from `contents` (items this course itself owns/uploaded to). See
  // CourseContentUsage's own comment.
  contentUsages CourseContentUsage[]

  @@index([status])
  @@index([category])
  @@index([categoryId])
  @@index([level])
  @@index([instructorId])
  @@index([createdAt])
  @@map("courses")
}

// Category Management Center — 2-level hierarchy (root categories + subcategories).
// Depth is enforced in the service (a parent must itself be a root). courseCount is
// always derived at read time (IMPACT_MAP R3) — never stored. Root-name uniqueness
// is also enforced app-side, since Postgres treats NULL parentId values as distinct
// in the composite unique below.
model Category {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@unique([name, parentId])
  @@index([parentId])
  @@map("categories")
}

model CourseEnrollment {
  id          String           @id @default(uuid())
  courseId    String
  userId      String
  progress    Int              @default(0)
  status      EnrollmentStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Added for the Learners module (learners.prisma / Part 3) — EXTENDED in
  // place rather than forked, same reasoning as every other model in this
  // codebase that gained fields for a later feature (Certificate.metadata,
  // Course's Wizard Step 4 block). All three nullable and additive: existing
  // callers (ENROLLMENTS_CONTRACT.md's POST /, the Learning Management
  // EnrollmentsTab) are entirely unaffected — they simply never set these.
  // startDate/expiryDate let an admin enroll someone with access opening or
  // closing on a different date than the enrollment record itself was created
  // (createdAt / "enrolledAt" in the API). cohortId is optional and points at
  // the EXISTING Group model (groups.prisma) — no new cohort concept invented.
  startDate  DateTime?
  expiryDate DateTime?
  cohortId   String?

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Group?  @relation(fields: [cohortId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([status])
  @@index([completedAt])
  @@index([createdAt])
  @@index([cohortId])
  @@map("course_enrollments")
}

// Content Library v1 — EXTENDED in place: this model already owns the LM
// content-stats tiles (groupBy type in lm.service), so a parallel ContentItem
// table would fork those numbers (IMPACT_MAP B2, same reasoning as Certificate).
// courseId is now OPTIONAL: null = library-wide item, set = course-scoped.
// filePath is the storage object key (needed to delete the object — never derived
// from fileUrl); both stay null on legacy seed rows, and reads/deletes tolerate
// that (same pattern as Certificate.verificationCode). uploadedBy is the AdminUser
// id, stored plain like AuditLog.adminId — no cross-schema FK.
model CourseContent {
  id         String      @id @default(uuid())
  courseId   String?
  title      String
  type       ContentType
  fileUrl    String?
  filePath   String?
  sizeBytes  Int?
  mimeType   String?
  tags       String[]    @default([])
  uploadedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  usages     CourseContentUsage[]

  @@index([courseId])
  @@index([type])
  @@index([createdAt])
  @@index([tags], type: Gin)
  @@map("course_contents")
}

// Content Library reuse across courses (CONTENT_LIBRARY_CONTRACT.md's
// documented v2 gap, "courseUsage[]" — no reuse mechanism existed). Additive
// alongside `CourseContent.courseId` (the item's ORIGINATING/owning course,
// or null for a library-wide item) — this join table is every OTHER course
// that has also linked the same item, so an item can be borrowed into
// multiple courses without duplicating the file or forking ownership.
model CourseContentUsage {
  id        String   @id @default(uuid())
  contentId String
  courseId  String
  addedAt   DateTime @default(now())

  content CourseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([contentId, courseId])
  @@index([contentId])
  @@index([courseId])
  @@map("course_content_usage")
}

// Live Sessions v1 — SCHEDULING only (no hosting features). EXTENDED in place:
// this model predates the feature and already feeds GET /api/admin/lm/live-sessions
// and Learning Path LIVE_SESSION items, so a parallel table would fork those
// surfaces (IMPACT_MAP B2). Meetings are created through the ./meetings provider
// adapter (Zoom Server-to-Server OAuth in v1): zoomMeetingId/joinUrl/startUrl are
// SERVER-written only — never accepted from the client. startUrl is the HOST link
// and must never be exposed to learners. `status` is stored but owned by the
// schedule: liveSessions.service lazily syncs it from startTime+durationMin on
// every read (no manual status writes), so the LM dashboard stays accurate free.
// Defaults on durationMin/timezone/provider backfill pre-existing seed rows.
model LiveSession {
  id              String              @id @default(uuid())
  title           String
  description     String?
  courseId        String?
  instructorId    String?
  startTime       DateTime
  durationMin     Int                 @default(60)
  timezone        String              @default("UTC")
  maxParticipants Int?
  provider        MeetingProvider     @default(ZOOM)
  zoomMeetingId   String?
  joinUrl         String?
  startUrl        String?
  status          LiveSessionStatus   @default(UPCOMING)
  // Set only by PATCH /:id/end (admin manual override) — presence means an
  // admin ended this session early, before its scheduled startTime+durationMin
  // window closed. deriveStatus() checks this FIRST, before any time math.
  endedAt         DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  course          Course?             @relation(fields: [courseId], references: [id])
  instructor      AppUser?            @relation("LiveSessionInstructor", fields: [instructorId], references: [id])
  // Per-learner attendance records (learners.prisma) — this model itself only
  // ever tracked the SCHEDULE, never who showed up.
  attendance      SessionAttendance[]

  @@index([status])
  @@index([startTime])
  @@index([courseId])
  @@index([instructorId])
  @@map("live_sessions")
}

// All providers the design doc names live in the enum (no future db push);
// v1 endpoints accept ZOOM only — MEET/TEAMS/OTHER are rejected with 400 until v2.
enum MeetingProvider {
  ZOOM
  MEET
  TEAMS
  OTHER
}

// Certificates v1 — EXTENDED in place (this model predates the Certificates
// system and already feeds the LM KPI + activity feed; a parallel IssuedCertificate
// table would double-count — IMPACT_MAP B2). One cert per (course, user); reissue
// UPDATES the row (new code + issuedAt, clears revokedAt) — never inserts. Revoke
// is soft (revokedAt) so the public verify endpoint can answer "revoked" and the
// audit trail survives. verificationCode is crypto-random (32 hex chars), nullable
// only for legacy rows — backfilled by scripts/backfillCertificateCodes.js.
// metadata holds an issue-time snapshot { studentName, courseTitle } so the
// certificate keeps rendering truthfully even if the course is renamed later.
// v1 triggers: MANUAL issue only (quiz/path/attendance runtimes don't exist yet);
// service exposes one issueCertificate() for future triggers to call.
model Certificate {
  id               String               @id @default(uuid())
  courseId         String
  userId           String
  templateId       String?
  verificationCode String?              @unique
  issuedAt         DateTime             @default(now())
  revokedAt        DateTime?
  expiresAt        DateTime?
  metadata         Json?
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             AppUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template         CertificateTemplate? @relation(fields: [templateId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([issuedAt])
  @@index([templateId])
  @@map("certificates")
}

// Layout is a small validated Json (colors, texts with fixed {{placeholders}},
// optional logo, signature) — rebuilt field-by-field in the validator, never
// arbitrary HTML. Deleting a template leaves issued certs intact (templateId
// SetNull) — they fall back to the default layout + their metadata snapshot.
//
// logoUrl/logoPath: added via the sign->PUT->confirm upload flow (never a
// free-text URL field — that would reopen the SSRF concern the v1 contract
// deferred this for). logoPath is bucket-internal bookkeeping (delete-on-
// replace/remove) and is NOT part of the documented CertificateTemplateLayout
// contract type — only logoUrl is. Both survive a plain name/color PATCH:
// updateTemplate re-attaches the current logoUrl/logoPath onto whatever layout
// the validator rebuilds, since PATCH's "layout replaces the whole object"
// rule would otherwise wipe the logo on every unrelated edit.
model CertificateTemplate {
  id        String   @id @default(uuid())
  name      String
  layout    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  certificates Certificate[]

  @@index([createdAt])
  @@map("certificate_templates")
}

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
  @@index([order])
  @@map("course_sections")
}

model Lesson {
  id          String        @id @default(uuid())
  sectionId   String
  title       String
  type        LessonType    @default(TEXT)
  content     String?
  durationMin Int?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([order])
  @@map("lessons")
}

// Learning Paths — ordered bundles of existing content. v1 items were COURSE and
// LIVE_SESSION only; QUIZ was added once the Quizzes system shipped (per the
// contract's "quizzes added when that system ships" note — Assignment/
// Certificate-template models still don't exist, so those stay out). itemId is a
// polymorphic reference with NO db-level FK — existence is verified in the
// service on insert, and reads flag dangling references (`missing: true`)
// instead of failing. Completion rules v1 = the single path-level `sequential`
// flag; per-item rules/prerequisites/deadlines are deferred until learner
// progress tracking exists.
model LearningPath {
  id          String   @id @default(uuid())
  title       String
  description String?
  sequential  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items LearningPathItem[]

  @@index([createdAt])
  @@map("learning_paths")
}

model LearningPathItem {
  id        String               @id @default(uuid())
  pathId    String
  itemType  LearningPathItemType
  itemId    String
  order     Int                  @default(0)
  createdAt DateTime             @default(now())

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, itemType, itemId])
  @@index([pathId, order])
  @@map("learning_path_items")
}

enum LearningPathItemType {
  COURSE
  LIVE_SESSION
  QUIZ
}

// Quizzes & Exams — assessment BUILDER v1 (admin side only). A quiz optionally
// attaches to a course (nullable FK like LiveSession — course delete sets it null);
// lesson-level attachment is deferred: the frontend key ['quizzes', courseId?] is
// course-scoped. QuestionType carries all 6 design-doc values; all 6 have a real
// editor now (MATCHING / FILL_IN_BLANK were schema-forward-compat-only at first,
// 400'd by the validator until their editor UI shipped).
// Grading v1 is a documented decision, not code: ESSAY = manual, the rest auto.
// Learner attempts/submissions (QuizAttempt) ship with the learner runtime.
// NOTE: the LM Content stats `quizzes` count stays owned by CourseContent
// type=QUIZ (lm.service) — this table does NOT feed that number (one field,
// one owner — IMPACT_MAP B2).
model Quiz {
  id                 String   @id @default(uuid())
  title              String
  description        String?
  courseId           String?
  passingGrade       Int      @default(60)
  attemptsAllowed    Int?
  timeLimit          Int?
  randomizeQuestions Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course    Course?       @relation(fields: [courseId], references: [id])
  questions Question[]
  // Learner attempts (learners.prisma) — the admin-facing half of the runtime
  // that doesn't otherwise exist yet (see QuizAttempt's model comment).
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([createdAt])
  @@map("quizzes")
}

model Question {
  id        String       @id @default(uuid())
  quizId    String
  type      QuestionType
  prompt    String
  data      Json?
  points    Int          @default(1)
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
  @@map("quiz_questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTI_SELECT
  ESSAY
  FILL_IN_BLANK
  MATCHING
}

enum LessonType {
  TEXT
  VIDEO_URL
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  PUBLISHED
  DRAFT
  PENDING
  ARCHIVED
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// AUDIO/IMAGE added for the Content Library (uploadable in v1 alongside VIDEO,
// DOCUMENT, PDF). QUIZ rows stay owned by the quiz flow and SCORM upload is v2 —
// both are rejected by the content validator, not removed from the enum.
enum ContentType {
  VIDEO
  DOCUMENT
  PDF
  QUIZ
  SCORM
  AUDIO
  IMAGE
}

enum LiveSessionStatus {
  UPCOMING
  LIVE
  ENDED
}

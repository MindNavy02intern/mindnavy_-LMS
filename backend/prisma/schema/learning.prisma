model Course {
  id           String             @id @default(uuid())
  title        String
  category     String
  level        CourseLevel        @default(BEGINNER)
  status       CourseStatus       @default(DRAFT)
  thumbnail    String?
  instructorId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    String?
  description  String?
  language     String?
  subtitle     String?
  tags         String[]           @default([])

  // Wizard Step 4 — settings. Owned exclusively by PATCH /courses/:id/settings;
  // the generic course PATCH never reads or writes these. price is integer cents.
  isFree             Boolean          @default(true)
  price              Int?
  currency           String?          @default("USD")
  enrollmentLimit    Int?
  visibility         CourseVisibility @default(PUBLIC)
  certificateEnabled Boolean          @default(false)
  dripContentEnabled Boolean          @default(false)
  accessRules        Json?
  seoTitle           String?
  seoDescription     String?

  // Approval workflow (submit → approve/reject). reviewedById = deciding admin;
  // rejectionReason is cleared again on resubmit/approve.
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  // Categories migration: optional FK alongside the legacy free-text `category`
  // string. Both are written in parallel until the frontend fully migrates.
  categoryId String?

  certificates Certificate[]
  contents     CourseContent[]
  enrollments  CourseEnrollment[]
  sections     CourseSection[]
  instructor   AppUser?           @relation("CourseInstructor", fields: [instructorId], references: [id])
  categoryRef  Category?          @relation(fields: [categoryId], references: [id])
  liveSessions LiveSession[]
  quizzes      Quiz[]

  @@index([status])
  @@index([category])
  @@index([categoryId])
  @@index([level])
  @@index([instructorId])
  @@index([createdAt])
  @@map("courses")
}

// Category Management Center — 2-level hierarchy (root categories + subcategories).
// Depth is enforced in the service (a parent must itself be a root). courseCount is
// always derived at read time (IMPACT_MAP R3) — never stored. Root-name uniqueness
// is also enforced app-side, since Postgres treats NULL parentId values as distinct
// in the composite unique below.
model Category {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@unique([name, parentId])
  @@index([parentId])
  @@map("categories")
}

model CourseEnrollment {
  id          String           @id @default(uuid())
  courseId    String
  userId      String
  progress    Int              @default(0)
  status      EnrollmentStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user        AppUser          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([status])
  @@index([completedAt])
  @@index([createdAt])
  @@map("course_enrollments")
}

model CourseContent {
  id        String      @id @default(uuid())
  courseId  String
  title     String
  type      ContentType
  createdAt DateTime    @default(now())
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([type])
  @@index([createdAt])
  @@map("course_contents")
}

model LiveSession {
  id        String            @id @default(uuid())
  title     String
  courseId  String?
  startTime DateTime
  status    LiveSessionStatus @default(UPCOMING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  course    Course?           @relation(fields: [courseId], references: [id])

  @@index([status])
  @@index([startTime])
  @@index([courseId])
  @@map("live_sessions")
}

model Certificate {
  id       String   @id @default(uuid())
  courseId String
  userId   String
  issuedAt DateTime @default(now())
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
  @@index([issuedAt])
  @@map("certificates")
}

model CourseSection {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId])
  @@index([order])
  @@map("course_sections")
}

model Lesson {
  id          String        @id @default(uuid())
  sectionId   String
  title       String
  type        LessonType    @default(TEXT)
  content     String?
  durationMin Int?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([order])
  @@map("lessons")
}

// Learning Paths — ordered bundles of existing content. v1 items are COURSE and
// LIVE_SESSION only (Quiz/Assignment/Certificate-template models don't exist yet;
// extend the enum when they ship). itemId is a polymorphic reference with NO db-level
// FK — existence is verified in the service on insert, and reads flag dangling
// references (`missing: true`) instead of failing. Completion rules v1 = the single
// path-level `sequential` flag; per-item rules/prerequisites/deadlines are deferred
// until learner progress tracking exists.
model LearningPath {
  id          String   @id @default(uuid())
  title       String
  description String?
  sequential  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items LearningPathItem[]

  @@index([createdAt])
  @@map("learning_paths")
}

model LearningPathItem {
  id        String               @id @default(uuid())
  pathId    String
  itemType  LearningPathItemType
  itemId    String
  order     Int                  @default(0)
  createdAt DateTime             @default(now())

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, itemType, itemId])
  @@index([pathId, order])
  @@map("learning_path_items")
}

enum LearningPathItemType {
  COURSE
  LIVE_SESSION
}

// Quizzes & Exams — assessment BUILDER v1 (admin side only). A quiz optionally
// attaches to a course (nullable FK like LiveSession — course delete sets it null);
// lesson-level attachment is deferred: the frontend key ['quizzes', courseId?] is
// course-scoped. QuestionType carries all 6 design-doc values so the enum never
// needs another db push, but v1 endpoints accept only MULTIPLE_CHOICE, TRUE_FALSE,
// MULTI_SELECT and ESSAY — MATCHING / FILL_IN_BLANK return 400 until v2.
// Grading v1 is a documented decision, not code: ESSAY = manual, the rest auto.
// Learner attempts/submissions (QuizAttempt) ship with the learner runtime.
// NOTE: the LM Content stats `quizzes` count stays owned by CourseContent
// type=QUIZ (lm.service) — this table does NOT feed that number (one field,
// one owner — IMPACT_MAP B2).
model Quiz {
  id                 String   @id @default(uuid())
  title              String
  description        String?
  courseId           String?
  passingGrade       Int      @default(60)
  attemptsAllowed    Int?
  timeLimit          Int?
  randomizeQuestions Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  course    Course?    @relation(fields: [courseId], references: [id])
  questions Question[]

  @@index([courseId])
  @@index([createdAt])
  @@map("quizzes")
}

model Question {
  id        String       @id @default(uuid())
  quizId    String
  type      QuestionType
  prompt    String
  data      Json?
  points    Int          @default(1)
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
  @@map("quiz_questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTI_SELECT
  ESSAY
  FILL_IN_BLANK
  MATCHING
}

enum LessonType {
  TEXT
  VIDEO_URL
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  PUBLISHED
  DRAFT
  PENDING
  ARCHIVED
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ContentType {
  VIDEO
  DOCUMENT
  PDF
  QUIZ
  SCORM
}

enum LiveSessionStatus {
  UPCOMING
  LIVE
  ENDED
}
